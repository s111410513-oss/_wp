generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Score {
  id            Int      @id @default(autoincrement())
  playerName    String
  mode          String   @default("normal")
  attempts      Int      @default(0)
  levelsCleared Int      @default(0)
  difficulty    String   @default("easy")
  createdAt     DateTime @default(now())
}
